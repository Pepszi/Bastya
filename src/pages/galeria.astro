---
import fs from 'node:fs';
import path from 'node:path';
import Layout from '../layouts/Layout.astro';

const galeriaDir = path.join(process.cwd(), 'public/galeria');
const images = fs
	.readdirSync(galeriaDir)
	.filter((file) => /\.webp$/i.test(file))
	.sort((a, b) => a.localeCompare(b, undefined, { numeric: true }))
	.map((file) => `/galeria/${file}`);
---

<Layout title="Galéria">
	<section class="bg-background py-20 max-md:py-14">
		<div class="mx-auto max-w-[90rem] px-6">
			<h1 class="text-primary">Galéria</h1>
			<div class="gallery-masonry mt-10">
				{
					images.map((src, index) => (
						<img
							src={src}
							alt={`Galéria kép ${index + 1}`}
							class="h-auto w-full"
							loading="lazy"
							decoding="async"
						/>
					))
				}
			</div>
		</div>
	</section>
</Layout>

<style>
	.gallery-masonry {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		grid-template-rows: masonry;
		gap: 1rem;
	}

	@supports not (grid-template-rows: masonry) {
		.gallery-masonry {
			display: block;
			columns: 4;
			column-gap: 1rem;
		}

		.gallery-masonry > img {
			break-inside: avoid;
			margin-bottom: 1rem;
		}
	}

	@media (max-width: 63.999rem) {
		.gallery-masonry {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}

		@supports not (grid-template-rows: masonry) {
			.gallery-masonry {
				columns: 3;
			}
		}
	}

	@media (max-width: 47.999rem) {
		.gallery-masonry {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		@supports not (grid-template-rows: masonry) {
			.gallery-masonry {
				columns: 2;
			}
		}
	}

	@media (max-width: 29.999rem) {
		.gallery-masonry {
			grid-template-columns: 1fr;
		}

		@supports not (grid-template-rows: masonry) {
			.gallery-masonry {
				columns: 1;
			}
		}
	}
</style>
