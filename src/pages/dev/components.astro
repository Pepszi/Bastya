---
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/Button.astro';
import EventCard from '../../components/EventCard.astro';
import PhotoGallery from '../../components/blocks/PhotoGallery.astro';
import YoutubeGallery from '../../components/blocks/YoutubeGallery.astro';
import Footer from '../../components/Footer.astro';
import Navigation from '../../components/Navigation.astro';
import ContactSection from '../../components/ContactSection.astro';

const catalog = [
	{ id: 'button', label: 'Button' },
	{ id: 'contact-section', label: 'Contact section' },
	{ id: 'event-card', label: 'Event card' },
	{ id: 'photo-gallery', label: 'Photo gallery' },
	{ id: 'youtube-gallery', label: 'YouTube gallery' },
	{ id: 'navigation', label: 'Navigation' },
	{ id: 'footer', label: 'Footer' },
];
---

<Layout title="Components" branded={false} noindex>

	<div class="mx-auto flex max-w-[90rem] gap-10 px-6 py-10 max-lg:flex-col">
		<aside class="w-56 shrink-0 max-lg:w-full">
			<div class="sticky top-24">
				<p class="mb-3 text-[0.75rem] font-medium uppercase tracking-wide text-secondary">
					Components
				</p>
				<nav aria-label="Component catalog">
					<ul class="flex flex-col gap-1 max-lg:flex-row max-lg:flex-wrap">
						{
							catalog.map((item) => (
								<li>
									<a
										href={`#${item.id}`}
										class="block rounded-[4px] px-2 py-1.5 text-[0.875rem] text-primary transition-colors hover:bg-border/40 hover:text-accent"
									>
										{item.label}
									</a>
								</li>
							))
						}
					</ul>
				</nav>
			</div>
		</aside>

		<div class="min-w-0 flex-1 space-y-16">
			<header class="border-b border-border pb-6">
				<h1 class="text-primary">Components</h1>
				<p class="mt-2 max-w-2xl text-[0.9375rem] text-secondary">
					Hidden overview of UI components. Not linked from the main navigation.
				</p>
			</header>

			<section id="button" class="scroll-mt-8">
				<div class="mb-6 flex flex-wrap items-baseline justify-between gap-2 border-b border-border pb-3">
					<h2 class="text-h4 font-medium text-primary">Button</h2>
					<code class="text-[0.75rem] text-secondary">src/components/Button.astro</code>
				</div>

				<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
					<div class="rounded-[8px] border border-border p-6">
						<p class="mb-4 text-[0.75rem] font-medium uppercase tracking-wide text-secondary">
							Primary
						</p>
						<Button variant="primary">Primary</Button>
					</div>
					<div class="rounded-[8px] border border-border p-6">
						<p class="mb-4 text-[0.75rem] font-medium uppercase tracking-wide text-secondary">
							Secondary accent
						</p>
						<Button variant="secondary-accent">Secondary accent</Button>
					</div>
					<div class="rounded-[8px] border border-border bg-primary p-6">
						<p class="mb-4 text-[0.75rem] font-medium uppercase tracking-wide text-background/70">
							Secondary white
						</p>
						<Button variant="secondary-white">Secondary white</Button>
					</div>
				</div>
			</section>

			<section id="contact-section" class="scroll-mt-8">
				<div class="mb-6 flex flex-wrap items-baseline justify-between gap-2 border-b border-border pb-3">
					<h2 class="text-h4 font-medium text-primary">Contact section</h2>
					<code class="text-[0.75rem] text-secondary">src/components/ContactSection.astro</code>
				</div>
				<p class="mb-6 max-w-2xl text-[0.9375rem] text-secondary">
					Kapcsolat page: FormSubmit form and the foundation contact details. Submitting this preview
					sends a real email.
				</p>
				<div class="overflow-hidden rounded-[8px] border border-border">
					<ContactSection heading="h2" />
				</div>
			</section>

			<section id="event-card" class="scroll-mt-8">
				<div class="mb-6 flex flex-wrap items-baseline justify-between gap-2 border-b border-border pb-3">
					<h2 class="text-h4 font-medium text-primary">Event card</h2>
					<code class="text-[0.75rem] text-secondary">src/components/EventCard.astro</code>
				</div>

				<ul class="grid grid-cols-3 gap-x-8 gap-y-12 max-lg:grid-cols-2 max-md:grid-cols-1">
					<li>
						<EventCard
							href="/esemenyek/jovobeli"
							title="Nyílt nap a bástyánál"
							dates="2026. október 18."
							summary="Egy délután a programról, kérdésekkel és egy rövid sétával az épületben."
							image="/galeria/galeria-02.webp"
							imageAlt="A bástya belső tere"
						/>
					</li>
				</ul>
			</section>

			<section id="photo-gallery" class="scroll-mt-8">
				<div class="mb-6 flex flex-wrap items-baseline justify-between gap-2 border-b border-border pb-3">
					<h2 class="text-h4 font-medium text-primary">Photo gallery</h2>
					<code class="text-[0.75rem] text-secondary">src/components/blocks/PhotoGallery.astro</code>
				</div>
				<PhotoGallery
					value={{
						_type: 'photo_gallery',
						_version: 1,
						_key: 'catalog-photos',
						images: [
							{ image: '/galeria/galeria-02.webp', caption: 'Belső tér' },
							{ image: '/galeria/galeria-08.webp', caption: 'Udvar' },
							{ image: '/galeria/galeria-16.webp' },
							{ image: '/galeria/galeria-17.webp' },
						],
					}}
					index={0}
					blockKey="catalog-photos"
				/>
			</section>

			<section id="youtube-gallery" class="scroll-mt-8">
				<div class="mb-6 flex flex-wrap items-baseline justify-between gap-2 border-b border-border pb-3">
					<h2 class="text-h4 font-medium text-primary">YouTube gallery</h2>
					<code class="text-[0.75rem] text-secondary">src/components/blocks/YoutubeGallery.astro</code>
				</div>
				<YoutubeGallery
					value={{
						_type: 'youtube_gallery',
						_version: 1,
						_key: 'catalog-videos',
						videos: [
							{ url: 'https://www.youtube.com/watch?v=xefdg-9LMuo', title: 'Adj esélyt' },
							{ url: 'https://youtu.be/xefdg-9LMuo', title: 'Rövid link' },
							{ url: 'https://www.youtube.com/embed/xefdg-9LMuo', title: 'Beágyazott link' },
						],
					}}
					index={0}
					blockKey="catalog-videos"
				/>
			</section>

			<section id="navigation" class="scroll-mt-8">
				<div class="mb-6 flex flex-wrap items-baseline justify-between gap-2 border-b border-border pb-3">
					<h2 class="text-h4 font-medium text-primary">Navigation</h2>
					<code class="text-[0.75rem] text-secondary">src/components/Navigation.astro</code>
				</div>

				<div class="overflow-hidden rounded-[8px] border border-border">
					<p class="border-b border-border bg-border/30 px-4 py-2 text-[0.75rem] font-medium uppercase tracking-wide text-secondary">
						Preview
					</p>
					<div class="bg-background">
						<Navigation preview />
					</div>
				</div>
			</section>

			<section id="footer" class="scroll-mt-8">
				<div class="mb-6 flex flex-wrap items-baseline justify-between gap-2 border-b border-border pb-3">
					<h2 class="text-h4 font-medium text-primary">Footer</h2>
					<code class="text-[0.75rem] text-secondary">src/components/Footer.astro</code>
				</div>

				<div class="overflow-hidden rounded-[8px] border border-border">
					<p class="border-b border-border bg-border/30 px-4 py-2 text-[0.75rem] font-medium uppercase tracking-wide text-secondary">
						Preview
					</p>
					<div class="bg-background">
						<Footer preview />
					</div>
				</div>
			</section>
		</div>
	</div>
</Layout>
