---
import type { HTMLAttributes } from 'astro/types';

type ButtonAttrs = Omit<HTMLAttributes<'button'>, 'type' | 'class'>;
type AnchorAttrs = Omit<HTMLAttributes<'a'>, 'href' | 'class'>;

interface Props extends ButtonAttrs, AnchorAttrs {
	variant?: 'primary' | 'secondary-accent' | 'secondary-white';
	href?: string;
	type?: 'button' | 'submit' | 'reset';
	class?: string;
}

const {
	variant = 'primary',
	href,
	type = 'button',
	class: className = '',
	...rest
} = Astro.props;

const base =
	'inline-flex cursor-pointer items-center justify-center rounded-[6px] px-4 py-2 text-[0.9375rem] font-medium transition-colors';

const variants = {
	primary: 'bg-accent text-background hover:bg-accent/90',
	'secondary-accent': 'border border-accent bg-transparent text-accent hover:bg-accent/10',
	'secondary-white': 'border border-background bg-transparent text-background hover:bg-background/10',
} as const;

const classes = [base, variants[variant], className].filter(Boolean).join(' ');
---

{
	href ? (
		<a href={href} class={classes} {...rest}>
			<slot />
		</a>
	) : (
		<button type={type} class={classes} {...rest}>
			<slot />
		</button>
	)
}
