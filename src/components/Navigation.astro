---
import Button from './Button.astro';

interface Props {
	preview?: boolean;
}

const { preview = false } = Astro.props;

const aboutLinks = [
	{ href: '/rolunk/csatlakozz-hozzank', label: 'Csatlakozz hozzánk' },
	{ href: '/rolunk/beszamolok-palyazatok', label: 'Beszámolók, pályázatok' },
];

const eventLinks = [
	{ href: '/esemenyek/jovobeli', label: 'Jövőbeli események' },
	{ href: '/esemenyek/lezajlott', label: 'Lezajlott események' },
];

const simpleLinks = [
	{ href: '/galeria', label: 'Galéria' },
	{ href: '/kapcsolat', label: 'Kapcsolat' },
];
---

<header class="relative border-b border-border bg-background">
	<nav
		class="mx-auto flex max-w-[90rem] items-center justify-between gap-6 px-6 py-4"
		aria-label="Fő navigáció"
		data-nav
	>
		<a href="/" class="shrink-0" aria-label="Kezdőlap">
			<img
				src="/global/logo.webp"
				alt="Bástya"
				class="h-10 w-auto"
				width="160"
				height="40"
			/>
		</a>

		<button
			type="button"
			class="hidden max-lg:inline-flex items-center justify-center rounded-[4px] border border-border p-2 text-primary"
			aria-expanded="false"
			aria-controls="primary-nav"
			data-nav-toggle
		>
			<span class="sr-only">Menü</span>
			<svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" data-nav-icon-open>
				<path d="M3 5h14v1.5H3V5zm0 4.25h14v1.5H3v-1.5zm0 4.25h14V15H3v-1.5z" />
			</svg>
			<svg class="hidden h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" data-nav-icon-close>
				<path d="M5.03 4.47 4.47 5.03 9.44 10l-4.97 4.97.56.56L10 10.56l4.97 4.97.56-.56L10.56 10l4.97-4.97-.56-.56L10 9.44 5.03 4.47z" />
			</svg>
		</button>

		<ul
			id="primary-nav"
			class="flex items-center gap-1 max-lg:absolute max-lg:left-0 max-lg:right-0 max-lg:top-full max-lg:z-50 max-lg:hidden max-lg:flex-col max-lg:items-stretch max-lg:gap-0 max-lg:border-b max-lg:border-border max-lg:bg-background max-lg:px-6 max-lg:py-3"
			data-nav-menu
		>
			<li class="group relative max-lg:border-b max-lg:border-border" data-dropdown>
				<button
					type="button"
					class="inline-flex items-center gap-1.5 px-3 py-2 text-[0.9375rem] font-medium text-primary transition-colors hover:text-accent max-lg:w-full max-lg:justify-between"
					aria-expanded="false"
					aria-haspopup="true"
					data-dropdown-toggle
				>
					Rólunk
					<svg class="h-3.5 w-3.5 text-secondary" viewBox="0 0 12 12" fill="none" aria-hidden="true">
						<path d="M2.5 4.5 6 8l3.5-3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
					</svg>
				</button>
				<ul
					class="absolute left-0 top-full z-50 hidden min-w-[14rem] rounded-[6px] border border-border bg-background py-1 shadow-sm group-hover:block group-focus-within:block max-lg:static max-lg:mt-0 max-lg:mb-2 max-lg:hidden max-lg:min-w-0 max-lg:border-0 max-lg:pl-3 max-lg:shadow-none max-lg:group-hover:hidden max-lg:group-focus-within:hidden"
					data-dropdown-menu
				>
					{
						aboutLinks.map((link) => (
							<li>
								<a
									href={link.href}
									class="block px-3 py-2 text-[0.875rem] text-primary transition-colors hover:bg-border/40 hover:text-accent max-lg:py-1.5"
								>
									{link.label}
								</a>
							</li>
						))
					}
				</ul>
			</li>

			<li class="group relative max-lg:border-b max-lg:border-border" data-dropdown>
				<button
					type="button"
					class="inline-flex items-center gap-1.5 px-3 py-2 text-[0.9375rem] font-medium text-primary transition-colors hover:text-accent max-lg:w-full max-lg:justify-between"
					aria-expanded="false"
					aria-haspopup="true"
					data-dropdown-toggle
				>
					Események
					<svg class="h-3.5 w-3.5 text-secondary" viewBox="0 0 12 12" fill="none" aria-hidden="true">
						<path d="M2.5 4.5 6 8l3.5-3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
					</svg>
				</button>
				<ul
					class="absolute left-0 top-full z-50 hidden min-w-[14rem] rounded-[6px] border border-border bg-background py-1 shadow-sm group-hover:block group-focus-within:block max-lg:static max-lg:mt-0 max-lg:mb-2 max-lg:hidden max-lg:min-w-0 max-lg:border-0 max-lg:pl-3 max-lg:shadow-none max-lg:group-hover:hidden max-lg:group-focus-within:hidden"
					data-dropdown-menu
				>
					{
						eventLinks.map((link) => (
							<li>
								<a
									href={link.href}
									class="block px-3 py-2 text-[0.875rem] text-primary transition-colors hover:bg-border/40 hover:text-accent max-lg:py-1.5"
								>
									{link.label}
								</a>
							</li>
						))
					}
				</ul>
			</li>

			{
				simpleLinks.map((link) => (
					<li class="max-lg:border-b max-lg:border-border">
						<a
							href={link.href}
							class="inline-flex px-3 py-2 text-[0.9375rem] font-medium text-primary transition-colors hover:text-accent max-lg:w-full"
						>
							{link.label}
						</a>
					</li>
				))
			}

			<li class="max-lg:pt-2">
				<Button href="/adomanyozas" variant="primary" class="max-lg:w-full">
					Adományozás
				</Button>
			</li>
		</ul>
	</nav>
</header>

{
	!preview && (
		<script>
			import { initNavigation } from '../scripts/navigation';
			initNavigation();
		</script>
	)
}
