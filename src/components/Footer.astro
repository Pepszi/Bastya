---
interface Props {
	preview?: boolean;
}

const { preview = false } = Astro.props;

const pageLinks = [
	{ href: '/rolunk/bemutatkozas', label: 'Bemutatkozás' },
	{ href: '/rolunk/bemutatkozas#csatlakozz', label: 'Csatlakozz hozzánk' },
	{ href: '/esemenyek/jovobeli', label: 'Jövőbeli események' },
	{ href: '/esemenyek/lezajlott', label: 'Lezajlott események' },
	{ href: '/galeria', label: 'Galéria' },
	{ href: '/kapcsolat', label: 'Kapcsolat' },
	{ href: '/adomanyozas', label: 'Adományozás' },
];

const legalLinks = [
	{ href: '/rolunk/beszamolok-palyazatok', label: 'Beszámolók, pályázatok' },
	{ href: '#', label: 'Szervezeti és Működési Szabályzat' },
	{ href: '/afsz', label: 'ÁFSZ' },
	{ href: '/adatkezelesi-tajekoztato', label: 'Adatkezelési tájékoztató' },
	{ href: '/impresszum', label: 'Impresszum' },
];

const currentYear = new Date().getFullYear();
---

<footer class="border-t border-border bg-background" data-footer={preview ? 'preview' : undefined}>
	<div class="mx-auto max-w-[90rem] px-6 py-12 max-md:py-10">
		<div class="grid grid-cols-2 gap-12 max-md:grid-cols-1 max-md:gap-10">
			<div>
				<p class="font-heading text-[1.5rem] font-bold text-primary">Elérhetőség</p>

				<p class="mt-6 text-[0.875rem] font-semibold text-secondary">Helyszín</p>
				<p class="mt-1 text-[1rem] text-primary">2310 Szigetszentmiklós, Kálvin tér 3.</p>

				<p class="mt-4 text-[0.875rem] font-semibold text-secondary">Telefon</p>
				<a
					href="tel:+36202862300"
					class="mt-1 inline-block text-[1rem] text-primary transition-colors hover:text-accent"
				>
					+36 20 286 2300
				</a>

				<p class="mt-4 text-[0.875rem] font-semibold text-secondary">Email</p>
				<a
					href="mailto:info@bastyaalapitvany.hu"
					class="mt-1 inline-block text-[1rem] text-primary transition-colors hover:text-accent"
				>
					info@bastyaalapitvany.hu
				</a>

				<p class="mt-6 text-[0.875rem] font-semibold text-secondary">Kövess minket</p>
				<div class="mt-2 flex items-center gap-3">
					<a
						href="https://www.facebook.com/profile.php?id=61573893372482"
						target="_blank"
						rel="noopener noreferrer"
						class="text-primary transition-colors hover:text-accent"
						aria-label="Facebook"
					>
						<svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
							<path
								d="M22 12.07C22 6.48 17.52 2 11.93 2S1.86 6.48 1.86 12.07c0 5.02 3.66 9.18 8.44 9.93v-7.02H7.9v-2.91h2.4V9.85c0-2.37 1.41-3.68 3.57-3.68 1.03 0 2.12.18 2.12.18v2.33h-1.2c-1.18 0-1.55.73-1.55 1.48v1.78h2.64l-.42 2.91h-2.22V22c4.78-.75 8.44-4.91 8.44-9.93z"
							/>
						</svg>
					</a>
					<a
						href="https://www.instagram.com/bastyaalapitvany?igsh=ZzVzYXJ0dDczOHNm"
						target="_blank"
						rel="noopener noreferrer"
						class="text-primary transition-colors hover:text-accent"
						aria-label="Instagram"
					>
						<svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
							<path
								d="M7.75 2h8.5A5.75 5.75 0 0 1 22 7.75v8.5A5.75 5.75 0 0 1 16.25 22h-8.5A5.75 5.75 0 0 1 2 16.25v-8.5A5.75 5.75 0 0 1 7.75 2zm0 1.5A4.25 4.25 0 0 0 3.5 7.75v8.5A4.25 4.25 0 0 0 7.75 20.5h8.5a4.25 4.25 0 0 0 4.25-4.25v-8.5A4.25 4.25 0 0 0 16.25 3.5h-8.5zm10 1.75a1 1 0 1 1 0 2 1 1 0 0 1 0-2zM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10zm0 1.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7z"
							/>
						</svg>
					</a>
					<a
						href="https://www.tiktok.com/@bastya.alaptvny?_r=1&_t=ZN-9548W0zWAsA"
						target="_blank"
						rel="noopener noreferrer"
						class="text-primary transition-colors hover:text-accent"
						aria-label="TikTok"
					>
						<svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
							<path
								d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.88-2.88 2.89 2.89 0 0 1 2.88-2.88c.28 0 .56.04.82.12V9.01a6.33 6.33 0 0 0-.82-.05A6.34 6.34 0 0 0 3.15 15.3a6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.34-6.34V8.73a8.2 8.2 0 0 0 4.76 1.52V6.8a4.85 4.85 0 0 1-1-.11z"
							/>
						</svg>
					</a>
				</div>
			</div>

			<div class="grid grid-cols-2 gap-10 max-sm:grid-cols-1">
				<nav aria-label="Oldalak">
					<p class="font-heading text-[1.5rem] font-bold text-primary">Oldalak</p>
					<ul class="mt-6 flex flex-col gap-2">
						{
							pageLinks.map((link) => (
								<li>
									<a
										href={link.href}
										class="text-[0.9375rem] font-medium text-primary transition-colors hover:text-accent"
									>
										{link.label}
									</a>
								</li>
							))
						}
					</ul>
				</nav>

				<nav aria-label="Jogi információk">
					<p class="font-heading text-[1.5rem] font-bold text-primary">Jogi információk</p>
					<ul class="mt-6 flex flex-col gap-2">
						{
							legalLinks.map((link) => (
								<li>
									<a
										href={link.href}
										class="text-[0.9375rem] font-medium text-primary transition-colors hover:text-accent"
									>
										{link.label}
									</a>
								</li>
							))
						}
					</ul>
				</nav>
			</div>
		</div>

		<div class="mt-10 flex flex-wrap items-center justify-between gap-x-6 gap-y-3 border-t border-border pt-6">
			<button
				type="button"
				class="cky-banner-element cursor-pointer text-[0.875rem] text-primary transition-colors hover:text-accent"
			>
				Sütibeállítások
			</button>
			<p class="text-[0.875rem] text-secondary">
				Minden jog fenntartva. © Copyright {currentYear} Bástya Terápiás Közösségi Alapítvány
			</p>
		</div>
	</div>
</footer>
