---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title?: string;
}

const { title = 'Astro' } = Astro.props;
---

<!doctype html>
<html lang="hu">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href="/global/favicon.png" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<link
			rel="preload"
			href="/fonts/Quicksand-VariableFont_wght.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<title>{title}</title>
		<ClientRouter />
		<slot name="head" />
	</head>
	<body class="bg-background text-primary font-sans">
		<Navigation />
		<main>
			<slot />
		</main>
		<Footer />
	</body>
</html>
